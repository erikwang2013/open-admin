# ============================================================
# 开放管理后台 — 单机生产部署环境变量模板
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
#
# 正式部署请执行 ./generate-secrets.sh 自动生成 deploy/.env（含随机密钥），
# 本文件仅列出全部配置项作为参考，不包含任何密钥，请勿直接用于生产。
# ============================================================

# ── 域名与端口（compose 端口映射） ──
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# ── 应用 ──
APP_NAME=开放管理后台
APP_DEBUG=false
APP_URL=https://localhost

# ── JWT（HS256，64 位十六进制） ──
JWT_SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=open-admin
JWT_AUDIENCE=open-admin
JWT_DEFAULT_EXPIRE=7200
JWT_REFRESH_EXPIRE=1209600

# ── Hashids ID 加解密盐值 ──
HASHIDS_SALT=
HASHIDS_ALT_SALT=

# ── Snowflake 主键 ──
SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_START_TIMESTAMP=1700000000000

# ── API 传输层加密（32 字符密钥 + RSA-2048 私钥 Base64） ──
ENCRYPTION_KEY=
ENCRYPTION_CIPHER=AES-256-CBC
ENCRYPTION_IV=
RSA_PRIVATE_KEY=

# ── 数据库字段加密（与传输层密钥独立） ──
ENCRYPTABLE_KEY=
ENCRYPTABLE_CIPHER=AES-256-CBC

# ── 验证码（文件缓存写到宿主机挂载目录） ──
POSTER_IMAGE_DRIVER=auto
POSTER_CAPTCHA_STORAGE=file
POSTER_CAPTCHA_FILE_PATH=/app/runtime/captcha
POSTER_CAPTCHA_TTL=300
POSTER_CAPTCHA_MAX_ATTEMPTS=3
POSTER_CAPTCHA_DIFFICULTY=medium

# ── MySQL（compose 服务名 mysql；init-app-user.sh 使用 DB_*） ──
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=open_admin
DB_USERNAME=open_admin
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Redis（compose 服务名 redis） ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_PREFIX=open-admin

# ── 初始管理员（仅 init 容器首次创建时使用） ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
