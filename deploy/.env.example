# ============================================================
# 开放管理后台 — 单机生产部署主配置模板
# Copyright (c) 2026 erik <erik@erik.xyz> — https://erik.xyz
#
# 正式部署请执行 ./generate-secrets.sh：它会生成随机密钥并分别写入
#   deploy/.env              仅 compose 插值（本文件内容），600
#   deploy/env/app.env       APP_* / JWT_* / HASHIDS_* / SNOWFLAKE_* /
#                            ENCRYPTION_*（含 RSA 私钥）/ ENCRYPTABLE_* /
#                            DB_*（仅应用用户）/ REDIS_* / POSTER_*，600
#   deploy/env/init.env      DB_*（仅应用用户）/ ADMIN_* / SNOWFLAKE_*，600
#   deploy/env/mysql.env     MYSQL_ROOT_PASSWORD / MYSQL_DATABASE / DB_*，600
#   deploy/env/redis.env     REDIS_PASSWORD，600
#   deploy/env/backup.env    MYSQL_ROOT_PASSWORD / MYSQL_DATABASE，600
#
# 本文件不含任何密钥，请勿直接用于生产。
# ============================================================

# ── 域名与端口（compose 端口映射） ──
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# ── 宿主机用户（容器以该 UID/GID 运行，挂载目录需归其所有） ──
# 首次生成时由 generate-secrets.sh 按当前用户 id -u / id -g 写入；之后显式设置的值会被保留
APP_UID=1000
APP_GID=1000
