APP_NAME=开放管理后台
APP_DEBUG=false
APP_URL=http://localhost

# JWT（占位符无效，仅本地试跑时替换）
JWT_SECRET_KEY=INVALID-LOCAL-ONLY-REPLACE-ME
JWT_ALGORITHM=HS256
JWT_ISSUER=open-admin
JWT_AUDIENCE=open-admin
JWT_DEFAULT_EXPIRE=7200
JWT_REFRESH_EXPIRE=1209600

HASHIDS_SALT=INVALID-LOCAL-ONLY-REPLACE-ME
HASHIDS_ALT_SALT=INVALID-LOCAL-ONLY-REPLACE-ME

SNOWFLAKE_DATACENTER_ID=1
SNOWFLAKE_WORKER_ID=1

ENCRYPTION_KEY=INVALID-LOCAL-ONLY-REPLACE-ME
ENCRYPTABLE_KEY=INVALID-LOCAL-ONLY-REPLACE-ME

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=open_admin
DB_USERNAME=root
DB_PASSWORD=root

REDIS_HOST=redis
REDIS_PREFIX=open-admin
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
